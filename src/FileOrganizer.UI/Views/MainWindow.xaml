<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileOrganizer.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FileOrganizer">

    <Grid Background="{StaticResource BackgroundBrush}">
        <NavigationView x:Name="MainNav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="232"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="MainNav_SelectionChanged"
                        Background="{StaticResource BackgroundBrush}">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,14,0,14">
                    <Border Width="36" Height="36" CornerRadius="12"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="17"
                                  Foreground="{StaticResource AccentPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="FileOrganizer" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="Local file workflows"
                                   Style="{StaticResource SubtleTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="NavSearchBox"
                                PlaceholderText="Search tasks and tools"
                                QueryIcon="Find"
                                TextChanged="NavSearchBox_TextChanged"
                                SuggestionChosen="NavSearchBox_SuggestionChosen"
                                QuerySubmitted="NavSearchBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="smart" Content="Smart Sort">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="organize" Content="Organize">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="files" Content="Files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="cleanup" Content="Cleanup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="duplicates" Content="Duplicates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="music" Content="Music">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="video" Content="Video">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="books" Content="Books">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="fonts" Content="Fonts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE185;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="code" Content="Source Code">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="subtitles" Content="Subtitles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED1E;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="MEDIA" IsEnabled="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph=""/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="photos" Content="Photos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="raw" Content="Raw Photos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBC6;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="comics" Content="Comics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEAD8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="watch" Content="Watch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Tag="toolbox" Content="Toolbox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Expander Grid.Row="0" x:Name="CapabilityExpander"
                          Visibility="Collapsed"
                          Margin="24,12,24,0"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="12">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14"
                                      Foreground="{StaticResource AccentPrimaryBrush}"/>
                            <TextBlock x:Name="CapabilityStatusText"
                                       Text="Checking workflow capabilities..."
                                       Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <Grid Padding="12,4,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Unavailable means the scope will not be checked; it never means no findings. Online rows remain not checked until a workflow contacts its provider."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1" ColumnSpacing="10" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="95"/><ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="145"/><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WORKFLOW" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="CAPABILITY" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Grid.Column="3" Text="DEPENDENCY" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Grid.Column="4" Text="VERSION" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Grid.Column="5" Text="SCOPE" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Grid.Column="6" Text="ACCESS" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Grid.Column="7" Text="REMEDIATION" Style="{StaticResource MetricLabelTextStyle}"/>
                        </Grid>
                        <ListView Grid.Row="2" x:Name="CapabilityRowsList"
                                  SelectionMode="None" MaxHeight="260">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="95"/><ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="145"/><ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Workflow}" Style="{StaticResource CodeTextStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Capability}" Style="{StaticResource CodeTextStyle}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Capability}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayStatus}" Style="{StaticResource CodeTextStyle}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Dependency}" Style="{StaticResource CodeTextStyle}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Dependency}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding DetectedVersion}" Style="{StaticResource CodeTextStyle}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DetectedVersion}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Scope}" Style="{StaticResource CodeTextStyle}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Scope}"/>
                                        <StackPanel Grid.Column="6" Spacing="1">
                                            <TextBlock Text="{Binding OnlineText}" Style="{StaticResource CodeTextStyle}"/>
                                            <TextBlock Text="{Binding RequiredText}" Style="{StaticResource SubtleTextStyle}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="7" Text="{Binding Remediation}" Style="{StaticResource CodeTextStyle}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Remediation}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Expander>
                <Frame Grid.Row="1" x:Name="ContentFrame"
                       Background="{StaticResource BackgroundBrush}"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
