<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileOrganizer.UI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Padding="32" RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Style="{StaticResource SubtitleTextStyle}"
                           Text="Pick a theme, set your defaults, and stash API keys here. Everything is saved automatically."/>
            </StackPanel>

            <!-- Theme picker -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE790;" FontSize="16"
                                  Foreground="{StaticResource AccentPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Theme" Style="{StaticResource PanelTitleTextStyle}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="Click any tile to switch instantly. Your choice is saved between launches."/>
                    <ItemsRepeater x:Name="ThemeRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="220" MinItemHeight="116"
                                               MinRowSpacing="12" MinColumnSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Id}" Click="ThemeTile_Click"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="{Binding TileBackground}"
                                        BorderBrush="{Binding TileBorder}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16,12">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                       Foreground="{Binding NameBrush}"
                                                       FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Indicator}"
                                                       Foreground="{Binding IndicatorBrush}"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{Binding DescriptionBrush}"
                                                   FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Swatch1}"/>
                                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Swatch2}"/>
                                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Swatch3}"/>
                                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Swatch4}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Music defaults -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8D6;" FontSize="16"
                                  Foreground="{StaticResource AccentVioletBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Music" Style="{StaticResource PanelTitleTextStyle}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="AcoustID API key (optional)"
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   Text="Only needed if you want fingerprint-based identification of untagged music. Existing-tag matching works without one. Stored in Windows Credential Locker, never ordinary app settings."/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0" x:Name="ApiKeyBox"/>
                            <HyperlinkButton Grid.Column="1" Content="Get a key (acoustid.org)"
                                             NavigateUri="https://acoustid.org/api-key"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Default rename pattern" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   Text="Tokens: {albumartist}, {album}, {title}, {year}, {track}, {disc}, {ext}. Use {disc:02} for zero-padded numbers."/>
                        <TextBox x:Name="MusicPatternBox" Style="{StaticResource PremiumTextBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Video / Books / Subtitles defaults -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="16"
                                  Foreground="{StaticResource AccentPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Other defaults" Style="{StaticResource PanelTitleTextStyle}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Video rename pattern" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Tokens: {title}, {year}, {season:02}, {episode:02}, {ext}"/>
                        <TextBox x:Name="VideoPatternBox" Style="{StaticResource PremiumTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Book rename pattern" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Tokens: {author}, {title}, {series}, {series_index}, {year}, {ext}"/>
                        <TextBox x:Name="BookPatternBox" Style="{StaticResource PremiumTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Default subtitle languages" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Comma-separated codes (en, es, fr, de, ja, …) — used by the Subtitles page."/>
                        <TextBox x:Name="LangsBox" Style="{StaticResource PremiumTextBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Watch mode startup -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7C8;" FontSize="16"
                                  Foreground="{StaticResource AccentGreenBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Watch Mode" Style="{StaticResource PanelTitleTextStyle}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="Start the configured Watch page folders automatically when you sign in to Windows. The per-user Task Scheduler entry runs hidden and does not require administrator access."/>

                    <ToggleSwitch x:Name="WatchStartupToggle"
                                  Header="Start configured watches at user logon"
                                  OffContent="Disabled" OnContent="Enabled"/>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Quiet window" Style="{StaticResource LabelTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="WatchDebounceSlider"
                                Minimum="2" Maximum="120" Value="30"
                                StepFrequency="1" ValueChanged="WatchDebounce_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="WatchDebounceValueText" Text="30 seconds"
                                   MinWidth="78" TextAlignment="Right"
                                   Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="A file must remain unchanged for this long before the background watcher routes it. Configure source and destination pairs on the Watch page first."/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Apply startup setting" Style="{StaticResource PrimaryButtonStyle}"
                                Click="WatchApply_Click"/>
                        <Button Content="Remove startup task" Style="{StaticResource GhostButtonStyle}"
                                Click="WatchRemove_Click"/>
                        <Button Content="Refresh log" Style="{StaticResource SecondaryButtonStyle}"
                                Click="WatchLog_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="WatchTaskStatusText" Text="Checking Task Scheduler…"
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    <TextBox x:Name="WatchLogBox" Header="Recent background events"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             Height="180" FontFamily="Cascadia Mono" FontSize="12"
                             PlaceholderText="No background events recorded yet."
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- Scheduled profiles -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE823;" FontSize="16"
                                  Foreground="{StaticResource AccentOrangeBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Schedules" Style="{StaticResource PanelTitleTextStyle}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="Run a saved scan profile through Windows Task Scheduler. Schedules are preview-only unless Auto-apply is explicitly enabled; tasks run hidden as the current user."/>

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="ScheduleProfileBox"
                                  Header="Saved profile" PlaceholderText="Choose a profile"/>
                        <ComboBox Grid.Column="1" x:Name="ScheduleFrequencyBox"
                                  Header="Frequency" SelectedIndex="0">
                            <ComboBoxItem Content="Daily" Tag="daily"/>
                            <ComboBoxItem Content="Weekly (Monday)" Tag="weekly"/>
                            <ComboBoxItem Content="Monthly (day 1)" Tag="monthly"/>
                            <ComboBoxItem Content="At logon" Tag="on_logon"/>
                        </ComboBox>
                        <TimePicker Grid.Column="2" x:Name="ScheduleTimePicker" Header="Local time"/>
                        <ToggleSwitch Grid.Column="3" x:Name="ScheduleAutoApplyToggle"
                                      Header="Apply mode" OffContent="Preview only" OnContent="Auto-apply"
                                      VerticalAlignment="Bottom"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Register schedule" Style="{StaticResource PrimaryButtonStyle}"
                                Click="ScheduleCreate_Click"/>
                        <ComboBox x:Name="ScheduleExistingBox" Width="260"
                                  PlaceholderText="Existing schedule"/>
                        <Button Content="Remove selected" Style="{StaticResource GhostButtonStyle}"
                                Click="ScheduleDelete_Click"/>
                        <Button Content="Refresh log" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ScheduleLog_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ScheduleStatusText" Text="Checking scheduled profiles…"
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    <ListView x:Name="ScheduleList" MaxHeight="170" SelectionMode="None"/>
                    <TextBox x:Name="ScheduleLogBox" Header="Recent scheduled-run events"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             Height="140" FontFamily="Cascadia Mono" FontSize="12"
                             PlaceholderText="No scheduled runs recorded yet."
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12">
                <Button Content="Save defaults" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click"/>
                <Button Content="Restore defaults" Style="{StaticResource GhostButtonStyle}"
                        Click="Reset_Click"/>
                <TextBlock x:Name="SaveStatusText"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
